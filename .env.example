# Copy to .env and fill in. NEVER commit .env.

# --- core ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SITE_URL=https://yourdomain.com

# Let Django serve uploaded product images (fine for one small server).
# Set False if Nginx / a CDN / S3 serves /media/ for you.
SERVE_MEDIA=True

# --- Razorpay (use LIVE keys in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > add https://yourdomain.com/razorpay/webhook/
# events: payment.captured, order.paid, payment.failed  (copy the secret you choose here)
RAZORPAY_WEBHOOK_SECRET=

# --- email (needed for order emails, password reset, contact form) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Vanshora <no-reply@yourdomain.com>

# --- affiliate program ---
AFFILIATE_DEFAULT_COMMISSION=5
AFFILIATE_COOKIE_DAYS=30
AFFILIATE_MIN_PAYOUT=500
AFFILIATE_AUTO_APPROVE=False

# --- optional PostgreSQL (SQLite is used when DB_NAME is empty) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
